    width: 34px;
    height: 34px;
    display: grid;
    place-items: center;
    font-family: var(--t);
    font-weight: 800;
    font-size: 1.25rem;
    line-height: 1;
    flex-shrink: 0;
  }
  .sx-crit-yes .sx-crit-sign { background: var(--y); color: var(--ink); }
  .sx-crit-no .sx-crit-sign {
    background: transparent;
    border: 1.5px solid rgba(26, 26, 26, 0.3);
    color: rgba(26, 26, 26, 0.55);
  }
  .sx-crit-head h3 {
    font-family: var(--t);
    font-weight: 700;
    font-size: clamp(1rem, 1.6vw, 1.1875rem);
    letter-spacing: -0.02em;
    color: var(--ink);
  }
  .sx-crit-col ul { list-style: none; padding: 0; margin: 0; }
  .sx-crit-col li {
    font-family: var(--m);
    font-size: 0.8125rem;
    line-height: 1.7;
    color: rgba(26, 26, 26, 0.7);
    padding: 0.75rem 0 0.75rem 1.5rem;
    border-bottom: 1px solid rgba(26, 26, 26, 0.07);
    position: relative;
  }
  .sx-crit-col li:last-child { border-bottom: none; }
  .sx-crit-col li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 1.32rem;
    width: 8px;
    height: 1.5px;
    background: var(--ink);
    opacity: 0.4;
  }
  .sx-crit-yes li::before { background: var(--y); opacity: 1; height: 3px; top: 1.25rem; }
  .sx-crit-foot {
    font-family: var(--m);
    font-size: 0.75rem;
    line-height: 1.8;
    color: rgba(26, 26, 26, 0.48);
    margin-top: 1.5rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--line);
  }

  /* ───── NERVO ───── */
  .sx-nervo { background: var(--night); }
  .sx-nervo-in {
    display: grid;
    grid-template-columns: 1fr 0.78fr;
    gap: clamp(2.5rem, 5vw, 5rem);
    align-items: center;
    padding-block: clamp(4.5rem, 8vw, 7.5rem);
  }
  .sx-nervo-nums {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1px;
    background: var(--line-l);
    border: 1px solid var(--line-l);
    margin: 2rem 0 2.5rem;
  }
  .sx-nervo-nums > div { background: var(--night); padding: 1.25rem; }
  .sx-nervo-nums strong {
    display: block;
    font-family: var(--t);
    font-weight: 800;
    font-size: clamp(1.25rem, 2.2vw, 1.75rem);
    letter-spacing: -0.035em;
    color: var(--y);
    margin-bottom: 0.5rem;
  }
  .sx-nervo-nums span {
    font-family: var(--m);
    font-size: 0.71875rem;
    line-height: 1.7;
    color: rgba(255, 255, 255, 0.5);
  }

  .sx-nervo-fig {
    background: var(--night2);
    border: 1px solid var(--line-l);
    padding: clamp(1.25rem, 2.5vw, 2rem);
  }
  .sx-nervo-fig svg { width: 100%; height: auto; display: block; }
  .sx-n-bone { fill: rgba(255, 255, 255, 0.045); }
  .sx-n-crest {
    fill: none;
    stroke: rgba(255, 255, 255, 0.2);
    stroke-width: 1;
    stroke-dasharray: 4 4;
  }
  .sx-n-ctx path {
    fill: rgba(255, 255, 255, 0.05);
    stroke: rgba(255, 255, 255, 0.28);
    stroke-width: 1.2;
    stroke-linejoin: round;
  }
  .sx-n-key path {
    fill: rgba(253, 225, 18, 0.14);
    stroke: var(--y);
    stroke-width: 1.6;
    stroke-linejoin: round;
  }
  .sx-n-canal {
    fill: none;
    stroke: rgba(255, 255, 255, 0.5);
    stroke-width: 7;
    stroke-linecap: round;
  }
  .sx-n-canal-in {
    fill: none;
    stroke: var(--night2);
    stroke-width: 3.5;
    stroke-linecap: round;
  }
  .sx-n-lab {
    font-family: var(--m);
    fill: rgba(255, 255, 255, 0.42);
    font-size: 10px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .sx-n-dim {
    font-family: var(--m);
    fill: var(--y);
    font-size: 14px;
    letter-spacing: 0.01em;
  }
  .sx-n-dimline { stroke: var(--y); stroke-width: 1.3; }
  .sx-n-ext {
    stroke: var(--y);
    stroke-width: 1;
    opacity: 0.45;
    stroke-dasharray: 3 3;
  }
  .sx-n-leader {
    fill: none;
    stroke: var(--y);
    stroke-width: 1.3;
    opacity: 0.8;
  }
  .sx-fig-cap {
    display: block;
    font-family: var(--m);
    font-size: 0.6875rem;
    line-height: 1.7;
    color: rgba(255, 255, 255, 0.34);
    margin-top: 1rem;
    padding-top: 0.875rem;
    border-top: 1px solid var(--line-l);
  }

  /* ───── PROTOCOLO ───── */
  .sx-proto { background: var(--paper); }
  .sx-proto > .sx-wrap { padding-block: clamp(4.5rem, 8vw, 7.5rem); }
  .sx-steps {
    list-style: none;
    padding: 0;
    margin: 0;
    border-top: 1px solid var(--line);
  }
  .sx-step {
    display: grid;
    grid-template-columns: 0.42fr 1fr;
    gap: clamp(1.5rem, 4vw, 3.5rem);
    align-items: center;
    padding-block: clamp(2rem, 3.5vw, 3rem);
    border-bottom: 1px solid var(--line);
  }
  .sx-step-img { overflow: hidden; background: var(--paper2); }
  .sx-step-img img {
    width: 100%;
    height: auto;
    aspect-ratio: 3 / 2;
    object-fit: cover;
    display: block;
    transition: transform 0.7s var(--e);
  }
  .sx-step:hover .sx-step-img img { transform: scale(1.04); }
  .sx-step-n {
    display: block;
    font-family: var(--t);
    font-weight: 900;
    font-size: clamp(1.75rem, 3vw, 2.5rem);
    line-height: 1;
    letter-spacing: -0.05em;
    color: var(--ink);
    opacity: 0.16;
    margin-bottom: 0.875rem;
  }
  .sx-step-txt h3 {
    font-family: var(--t);
    font-weight: 700;
    font-size: clamp(1.125rem, 2vw, 1.5rem);
    letter-spacing: -0.025em;
    color: var(--ink);
    margin-bottom: 0.75rem;
  }
  .sx-step-txt p {
    font-family: var(--m);
    font-size: 0.84375rem;
    line-height: 1.9;
    color: rgba(26, 26, 26, 0.65);
    max-width: 68ch;
  }

  /* ───── CONFORTO ───── */
  .sx-conforto { background: var(--paper2); }
  .sx-conforto > .sx-wrap { padding-block: clamp(4.5rem, 8vw, 7.5rem); }
  .sx-tabela { border: 1px solid var(--line); background: var(--paper); }
  .sx-tr {
    display: grid;
    grid-template-columns: 0.22fr 1fr 0.28fr;
    gap: 1.25rem;
    padding: 1.125rem clamp(1rem, 2vw, 1.75rem);
    border-bottom: 1px solid var(--line);
    align-items: baseline;
  }
  .sx-tr:last-child { border-bottom: none; }
  .sx-tr-head {
    background: var(--ink);
    border-bottom: none;
  }
  .sx-tr span {
    font-family: var(--m);
    font-size: 0.8125rem;
    line-height: 1.75;
    color: rgba(26, 26, 26, 0.65);
  }
  .sx-tr.sx-tr-head span {
    font-size: 0.625rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.62);
  }
  .sx-tr b {
    font-family: var(--t);
    font-weight: 700;
    font-size: 0.9375rem;
    letter-spacing: -0.015em;
    color: var(--ink);
  }

  /* ───── RECUPERAÇÃO ───── */
  .sx-rec { background: var(--paper); }
  .sx-rec > .sx-wrap { padding-block: clamp(4.5rem, 8vw, 7.5rem); }
  .sx-timeline {
    position: relative;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: clamp(1rem, 2.5vw, 2rem);
    padding-top: 2.75rem;
  }
  .sx-tl-track {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 14px;
    background-image: repeating-linear-gradient(
      to right,
      rgba(26, 26, 26, 0.3) 0 1px,
      transparent 1px 9px
    );
    border-top: 1.5px solid var(--ink);
  }
  .sx-tl-item { position: relative; }
  .sx-tl-day {
    display: inline-block;
    font-family: var(--m);
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    background: var(--y);
    color: var(--ink);
    padding: 0.3125rem 0.625rem;
    margin-bottom: 1rem;
  }
  .sx-tl-img { overflow: hidden; background: var(--paper2); margin-bottom: 1.125rem; }
  .sx-tl-img img {
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    display: block;
  }
  .sx-tl-noimg {
    aspect-ratio: 4 / 5;
    background: var(--ink);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: flex-end;
    padding: 1.25rem;
    gap: 0.25rem;
  }
  .sx-tl-hour {
    font-family: var(--t);
    font-weight: 800;
    font-size: clamp(1.5rem, 3vw, 2.25rem);
    letter-spacing: -0.04em;
    line-height: 1;
    color: var(--y);
  }
  .sx-tl-noimg em {
    font-style: normal;
    font-family: var(--m);
    font-size: 0.6875rem;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.5);
  }
  .sx-tl-item h3 {
    font-family: var(--t);
    font-weight: 700;
    font-size: 1.0625rem;
    letter-spacing: -0.02em;
    color: var(--ink);
    margin-bottom: 0.625rem;
  }
  .sx-tl-item p {
    font-family: var(--m);
    font-size: 0.78125rem;
    line-height: 1.8;
    color: rgba(26, 26, 26, 0.6);
  }

  .sx-atestado {
    display: grid;
    grid-template-columns: 0.8fr 1fr;
    gap: clamp(1.5rem, 4vw, 3.5rem);
    align-items: center;
    margin-top: clamp(3rem, 5vw, 4.5rem);
    padding: clamp(1.75rem, 3.5vw, 2.75rem);
    background: var(--paper2);
    border: 1px solid var(--line);
  }
  .sx-atestado ul { list-style: none; padding: 0; margin: 0; }
  .sx-atestado li {
    font-family: var(--m);
    font-size: 0.84375rem;
    line-height: 1.7;
    color: rgba(26, 26, 26, 0.68);
    padding: 0.75rem 0;
    border-bottom: 1px solid var(--line);
  }
  .sx-atestado li:last-child { border-bottom: none; }
  .sx-atestado b {
    font-family: var(--t);
    font-weight: 700;
    color: var(--ink);
    margin-right: 0.5rem;
  }

  /* Único bloco de amarelo sólido da página: sinal clínico, não decoração */
  .sx-alerta {
    background: var(--y);
    color: var(--ink);
    margin-top: 1.25rem;
    padding: clamp(1.75rem, 3.5vw, 2.75rem);
  }
  .sx-alerta-head {
    display: flex;
    align-items: center;
    gap: 0.875rem;
    padding-bottom: 1.25rem;
    margin-bottom: 1.25rem;
    border-bottom: 1.5px solid rgba(26, 26, 26, 0.22);
  }
  .sx-alerta-sig {
    width: 32px;
    height: 32px;
    display: grid;
    place-items: center;
    background: var(--ink);
    color: var(--y);
    font-family: var(--t);
    font-weight: 900;
    font-size: 1.125rem;
    line-height: 1;
    flex-shrink: 0;
  }
  .sx-alerta-head h3 {
    font-family: var(--t);
    font-weight: 800;
    font-size: clamp(1.0625rem, 2vw, 1.4375rem);
    letter-spacing: -0.025em;
    color: var(--ink);
  }
  .sx-alerta ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0 2.5rem;
  }
  .sx-alerta li {
    font-family: var(--m);
    font-size: 0.8125rem;
    line-height: 1.75;
    color: rgba(26, 26, 26, 0.78);
    padding: 0.8125rem 0;
    border-bottom: 1px solid rgba(26, 26, 26, 0.16);
  }
  .sx-alerta b {
    font-family: var(--t);
    font-weight: 700;
    color: var(--ink);
  }
  .sx-alerta > p {
    font-family: var(--m);
    font-size: 0.75rem;
    line-height: 1.75;
    color: rgba(26, 26, 26, 0.6);
    margin-top: 1.25rem;
  }

  /* ───── VALOR ───── */
  .sx-valor { background: var(--night); }
  .sx-valor-in {
    display: grid;
    grid-template-columns: 1fr 0.92fr;
    gap: clamp(2.5rem, 5vw, 5rem);
    align-items: start;
    padding-block: clamp(4.5rem, 8vw, 7.5rem) clamp(2rem, 3vw, 3rem);
  }
  .sx-valor-in .sx-btn { margin-top: 2rem; }
  .sx-valor-list {
    list-style: none;
    padding: 0;
    margin: 0;
    border-top: 1px solid var(--line-l);
  }
  .sx-valor-list li {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 1.25rem;
    padding: 1.25rem 0;
    border-bottom: 1px solid var(--line-l);
  }
  .sx-valor-list span {
    font-family: var(--t);
    font-weight: 800;
    font-size: 0.875rem;
    color: var(--y);
    letter-spacing: 0.02em;
  }
  .sx-valor-list b {
    display: block;
    font-family: var(--t);
    font-weight: 700;
    font-size: 1rem;
    letter-spacing: -0.02em;
    color: #fff;
    margin-bottom: 0.375rem;
  }
  .sx-valor-list p {
    font-family: var(--m);
    font-size: 0.78125rem;
    line-height: 1.75;
    color: rgba(255, 255, 255, 0.5);
  }
  .sx-valor-nota { padding-bottom: clamp(3rem, 5vw, 4.5rem); }
  .sx-valor-nota p {
    font-family: var(--m);
    font-size: 0.75rem;
    line-height: 1.85;
    color: rgba(255, 255, 255, 0.38);
    max-width: 80ch;
    padding-top: 1.5rem;
    border-top: 1px solid var(--line-l);
  }

  /* ───── CIRURGIÕES ───── */
  .sx-cir { background: var(--paper); }
  .sx-cir > .sx-wrap { padding-block: clamp(4.5rem, 8vw, 7.5rem); }
  .sx-cir-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1px;
    background: var(--line);
    border: 1px solid var(--line);
  }
  .sx-cir-card { background: var(--paper); display: grid; grid-template-columns: 0.62fr 1fr; }
  .sx-cir-img { overflow: hidden; background: var(--paper2); }
  .sx-cir-img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
    display: block;
  }
  .sx-cir-body { padding: clamp(1.5rem, 2.5vw, 2rem); }
  .sx-cir-body h3 {
    font-family: var(--t);
    font-weight: 800;
    font-size: clamp(1.125rem, 1.9vw, 1.4375rem);
    letter-spacing: -0.028em;
    color: var(--ink);
    margin-bottom: 0.4375rem;
  }
  .sx-cir-cro {
    display: inline-block;
    font-family: var(--m);
    font-size: 0.625rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: rgba(26, 26, 26, 0.5);
    border: 1px solid var(--line);
    padding: 0.25rem 0.5rem;
    margin-bottom: 1.25rem;
  }
  .sx-cir-body ul { list-style: none; padding: 0; margin: 0; }
  .sx-cir-body li {
    font-family: var(--m);
    font-size: 0.78125rem;
    line-height: 1.65;
    color: rgba(26, 26, 26, 0.65);
    padding: 0.625rem 0;
    border-bottom: 1px solid rgba(26, 26, 26, 0.08);
  }
  .sx-cir-body li:last-child { border-bottom: none; }

  .sx-cir-foto {
    margin: clamp(2rem, 4vw, 3rem) 0 0;
    display: grid;
    grid-template-columns: 0.52fr 1fr;
    gap: clamp(1.5rem, 4vw, 3.5rem);
    align-items: center;
    background: var(--ink);
    padding: clamp(1.25rem, 2.5vw, 2rem);
  }
  .sx-cir-foto img {
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    display: block;
  }
  .sx-cir-foto figcaption {
    font-family: var(--m);
    font-size: 0.84375rem;
    line-height: 1.9;
    color: rgba(255, 255, 255, 0.58);
    max-width: 58ch;
  }
  .sx-cir-foto b {
    display: block;
    font-family: var(--t);
    font-weight: 700;
    font-size: clamp(1.0625rem, 1.9vw, 1.375rem);
    letter-spacing: -0.025em;
    color: #fff;
    margin-bottom: 0.75rem;
  }

  /* ───── DEPOIMENTOS ───── */
  .sx-dep { background: var(--paper2); }
  .sx-dep > .sx-wrap { padding-block: clamp(4.5rem, 8vw, 7.5rem); }
  .sx-dep-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1px;
    background: var(--line);
    border: 1px solid var(--line);
  }
  .sx-dep-card {
    margin: 0;
    background: var(--paper);
    padding: clamp(1.75rem, 3.2vw, 2.75rem);
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
  }
  .sx-dep-card p {
    font-family: var(--m);
    font-size: 0.84375rem;
    line-height: 1.9;
    color: rgba(26, 26, 26, 0.7);
    flex: 1;
  }
  .sx-dep-card footer { display: flex; flex-direction: column; gap: 0.5rem; }
  .sx-dep-card footer span {
    font-family: var(--t);
    font-weight: 700;
    font-size: 0.9375rem;
    color: var(--ink);
  }
  .sx-dep-card footer em {
    font-style: normal;
    font-family: var(--m);
    font-size: 0.625rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: rgba(26, 26, 26, 0.5);
    border-left: 2px solid var(--y);
    padding-left: 0.5rem;
    width: fit-content;
  }

  /* ───── FAQ ───── */
  .sx-faq { background: var(--paper); border-top: 1px solid var(--line); }
  .sx-faq-in {
    display: grid;
    grid-template-columns: 0.72fr 1fr;
    gap: clamp(2.5rem, 5vw, 5rem);
    align-items: start;
    padding-block: clamp(4.5rem, 8vw, 7.5rem);
  }
  .sx-faq-side { position: sticky; top: calc(64px + 2rem); }
  .sx-faq-side .sx-btn { margin-top: 2rem; }
  .sx-faq-list { border-top: 1px solid var(--line); }
  .sx-faq-item { border-bottom: 1px solid var(--line); }
  .sx-faq-item summary {
    font-family: var(--t);
    font-weight: 600;
    font-size: clamp(0.9375rem, 1.5vw, 1.0625rem);
    letter-spacing: -0.018em;
    color: var(--ink);
    padding: 1.375rem 2.5rem 1.375rem 0;
    cursor: pointer;
    list-style: none;
    position: relative;
  }
  .sx-faq-item summary::-webkit-details-marker { display: none; }
  .sx-faq-item summary::after {
    content: "";
    position: absolute;
    right: 0.375rem;
    top: 50%;
    width: 13px;
    height: 1.5px;
    background: var(--ink);
    transform: translateY(-50%);
  }
  .sx-faq-item summary::before {
    content: "";
    position: absolute;
    right: 0.375rem;
    top: 50%;
    width: 13px;
    height: 1.5px;
    background: var(--ink);
    transform: translateY(-50%) rotate(90deg);
    transition: transform 0.25s var(--e), opacity 0.25s var(--e);
  }
  .sx-faq-item[open] summary::before { transform: translateY(-50%) rotate(0deg); opacity: 0; }
  .sx-faq-a { padding-bottom: 1.625rem; max-width: 66ch; }
  .sx-faq-a p {
    font-family: var(--m);
    font-size: 0.84375rem;
    line-height: 1.95;
    color: rgba(26, 26, 26, 0.65);
  }

  /* ───── CTA ───── */
  .sx-cta { background: var(--night); }
  .sx-cta-in {
    display: grid;
    grid-template-columns: 1fr 0.78fr;
    gap: clamp(2.5rem, 5vw, 5rem);
    align-items: center;
    padding-block: clamp(4.5rem, 8vw, 7rem);
  }
  .sx-cta-h {
    font-family: var(--t);
    font-weight: 800;
    font-size: clamp(2rem, 4.2vw, 3.5rem);
    line-height: 1.03;
    letter-spacing: -0.035em;
    color: #fff;
    margin-bottom: 1.25rem;
    max-width: 16ch;
  }
  .sx-cta-copy p {
    font-family: var(--m);
    font-size: 0.9375rem;
    line-height: 1.85;
    color: rgba(255, 255, 255, 0.6);
    max-width: 52ch;
    margin-bottom: 2.25rem;
  }
  .sx-cta-img { position: relative; }
  .sx-cta-img::before {
    content: "";
    position: absolute;
    left: -1px;
    top: -1px;
    width: 42%;
    height: 8px;
    background: var(--y);
