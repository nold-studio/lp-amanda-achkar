    const b = document.getElementById("sx-burger");
    const l = document.getElementById("sx-links");
    if (b && l) {
      b.addEventListener("click", () => {
        const open = b.getAttribute("aria-expanded") === "true";
        b.setAttribute("aria-expanded", String(!open));
        l.classList.toggle("sx-open", !open);
