          <line class="sx-n-ext" x1="232" y1="150" x2="258" y2="150" />
          <line class="sx-n-dimline" x1="252" y1="130" x2="252" y2="150" />
          <line class="sx-n-dimline" x1="246" y1="130" x2="258" y2="130" />
          <line class="sx-n-dimline" x1="246" y1="150" x2="258" y2="150" />
          <path class="sx-n-leader" d="M252 140 L292 108 L340 108" />
