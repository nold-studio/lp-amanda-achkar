{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "astro",
  "buildCommand": "astro build",
  "outputDirectory": "dist",
  "redirects": [
    { "source": "/r1", "destination": "/", "permanent": true },
    { "source": "/eliezer", "destination": "/dr-eliezer", "permanent": true }
  ],
  "rewrites": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "enare.maxfocos.com.br" }],
      "destination": "/enare"
    }
  ]
}
